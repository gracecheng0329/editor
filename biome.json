{
   "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
   "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
   },
   "files": {
      "ignoreUnknown": false,
      "includes": ["**", "!!**/dist", "!!**/build", "!!.agents", "!!**/*.{md, yml}"]
   },
   "formatter": {
      "enabled": true,
      "lineWidth": 100,
      "indentStyle": "space",
      "indentWidth": 3
   },
   "linter": {
      "enabled": true,
      "rules": {
         "preset": "recommended"
      }
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "single",
         "trailingCommas": "all",
         "semicolons": "asNeeded",
         "jsxQuoteStyle": "single"
      }
   },
   "assist": {
      "enabled": true,
      "actions": {
         "source": {
            "organizeImports": "on"
         }
      }
   }
}
